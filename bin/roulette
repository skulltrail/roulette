detect_wsl() {
  if grep -qEi "(Microsoft|WSL)" /proc/version &>/dev/null; then
    IS_WSL=true
    echo "WSL environment detected."
  fi
}

detect_macos() {
  if [[ "${OSTYPE}" == darwin* ]]; then
    IS_MACOS=true
    echo "macOS environment detected."
  fi
}

refocus_terminal() {
  if [[ "${IS_MACOS}" == true ]] && command -v osascript >/dev/null 2>&1; then
    local app="${TERM_PROGRAM:-Terminal}"
    [[ "${app}" == "Apple_Terminal" ]] && app="Terminal"
    osascript -e "tell application \"${app}\" to activate" >/dev/null 2>&1 || true
  fi
}

stdin_is_interactive_tty() {
  [[ -t 0 ]] && [[ -r /dev/tty ]]
}

drain_tty_input_buffer() {
  stdin_is_interactive_tty || return 0

  while IFS= read -r -t 0 -n 1 </dev/tty; do
    IFS= read -r -n 1 </dev/tty || break
  done
}

read_single_key() {
  local __target_var="$1"
  local captured_key=""
  local read_status=0

  if stdin_is_interactive_tty; then
    IFS= read -r -n 1 captured_key </dev/tty
    read_status=$?
  else
    IFS= read -r -n 1 captured_key
    read_status=$?
  fi

  printf -v "${__target_var}" '%s' "${captured_key}"
  return "${read_status}"
}

trim_surrounding_whitespace() {
  local value="$1"
  value="${value#"${value%%[!$' \t\r\n']*}"}"
  value="${value%"${value##*[!$' \t\r\n']}"}"
  printf '%s\n' "${value}"
}

detect_media_directory() {
  # Check ROULETTE_PATH environment variable first
  if [[ -n "${ROULETTE_PATH}" ]]; then
    DIRECTORY_PATHS=()
    local env_paths=()
    local env_path=""
    IFS=':' read -r -a env_paths <<<"${ROULETTE_PATH}"

    for env_path in "${env_paths[@]}"; do
      env_path="$(trim_surrounding_whitespace "${env_path}")"
      [[ -z "${env_path}" ]] && continue
      local normalized_env_path=""
      if normalized_env_path=$(normalize_directory_path "${env_path}"); then
        add_directory_path "${normalized_env_path}"
      else
        echo "WARNING: ROULETTE_PATH entry not found: ${env_path/#\~/${HOME}}"
      fi
    done

    if [[ ${#DIRECTORY_PATHS[@]} -gt 0 ]]; then
      DIRECTORY_PATH="${DIRECTORY_PATHS[0]}"
      print_directory_selection "Using ROULETTE_PATH"
      return 0
    fi

    echo "WARNING: ROULETTE_PATH set but no valid directories were found: ${ROULETTE_PATH}"
  fi

  DIRECTORY_PATHS=()
  local path=""
  local normalized_path=""
  while IFS= read -r path; do
    path="$(trim_surrounding_whitespace "${path}")"
    [[ -z "${path}" ]] && continue
    if normalized_path=$(normalize_directory_path "${path}"); then
      add_directory_path "${normalized_path}"
    fi
  done < <(get_default_media_paths)

  if [[ ${#DIRECTORY_PATHS[@]} -gt 0 ]]; then
    DIRECTORY_PATH="${DIRECTORY_PATHS[0]}"
    print_directory_selection "Found media"
    return 0
  fi

  DIRECTORY_PATH="$(trim_surrounding_whitespace "$(get_default_media_paths | sed -n '1p')")"
  DIRECTORY_PATHS=("${DIRECTORY_PATH}")

  echo "WARNING: Media directory not found. Using default: ${DIRECTORY_PATH}"
  return 1
}

get_default_media_paths() {
  if [[ "${IS_MACOS}" == true ]]; then
    printf '%s\n' \
      "/Volumes/media/downloads/video" \
      "/Volumes/media/archive/video"
  elif [[ "${IS_WSL}" == true ]]; then
    printf '%s\n' \
      "/mnt/media/archive/video" \
      "/media/archive/video" \
      "/mnt/m/media/archive/video"
  else
    printf '%s\n' \
      "/media/archive/video" \
      "/mnt/media/archive/video"
  fi
}

get_default_downloads_paths() {
  if [[ "${IS_MACOS}" == true ]]; then
    printf '%s\n' \
      "/Volumes/media/downloads/video"
  elif [[ "${IS_WSL}" == true ]]; then
    printf '%s\n' \
      "/mnt/media/downloads/video" \
      "/media/downloads/video" \
      "/mnt/m/media/downloads/video"
  else
    printf '%s\n' \
      "/media/downloads/video" \
      "/mnt/media/downloads/video"
  fi
}

get_default_main_paths() {
  if [[ "${IS_MACOS}" == true ]]; then
    printf '%s\n' \
      "/Volumes/media/archive/video"
  elif [[ "${IS_WSL}" == true ]]; then
    printf '%s\n' \
      "/mnt/media/archive/video" \
      "/media/archive/video" \
      "/mnt/m/media/archive/video"
  else
    printf '%s\n' \
      "/media/archive/video" \
      "/mnt/media/archive/video"
  fi
}

normalize_defined_path() {
  local candidate_path="$1"
  candidate_path="$(trim_surrounding_whitespace "${candidate_path}")"
  candidate_path="${candidate_path/#\~/${HOME}}"

  if [[ "${candidate_path}" != "/" ]]; then
    candidate_path="${candidate_path%/}"
  fi

  if [[ -d "${candidate_path}" ]]; then
    normalize_directory_path "${candidate_path}"
    return
  fi

  printf '%s\n' "${candidate_path}"
}

resolve_defined_path_from_candidates() {
  local candidate_path=""
  local first_candidate=""
  local normalized_path=""

  while IFS= read -r candidate_path; do
    candidate_path="$(trim_surrounding_whitespace "${candidate_path}")"
    [[ -z "${candidate_path}" ]] && continue

    if [[ -z "${first_candidate}" ]]; then
      first_candidate="${candidate_path}"
    fi

    if normalized_path=$(normalize_directory_path "${candidate_path}"); then
      printf '%s\n' "${normalized_path}"
      return 0
    fi
  done

  [[ -n "${first_candidate}" ]] || return 1
  normalize_defined_path "${first_candidate}"
}

configure_promote_paths() {
  local configured_path=""

  if [[ -n "${ROULETTE_DOWNLOADS_PATH:-}" ]]; then
    PROMOTE_DOWNLOADS_PATH="$(normalize_defined_path "${ROULETTE_DOWNLOADS_PATH}")"
  elif configured_path=$(get_default_downloads_paths | resolve_defined_path_from_candidates); then
    PROMOTE_DOWNLOADS_PATH="${configured_path}"
  fi

  if [[ -n "${ROULETTE_MAIN_PATH:-}" ]]; then
    PROMOTE_MAIN_PATH="$(normalize_defined_path "${ROULETTE_MAIN_PATH}")"
  elif configured_path=$(get_default_main_paths | resolve_defined_path_from_candidates); then
    PROMOTE_MAIN_PATH="${configured_path}"
  fi

  debug_log "Promote paths: downloads='${PROMOTE_DOWNLOADS_PATH}' main='${PROMOTE_MAIN_PATH}'"
}

normalize_directory_path() {
  local candidate_path="$1"
  candidate_path="${candidate_path/#\~/${HOME}}"
  [[ -d "${candidate_path}" ]] || return 1

  (
    cd "${candidate_path}" >/dev/null 2>&1 && pwd -P
  )
}

add_directory_path() {
  local candidate_path="$1"
  local existing_path=""
  for existing_path in "${DIRECTORY_PATHS[@]}"; do
    [[ "${existing_path}" == "${candidate_path}" ]] && return 0
  done
  DIRECTORY_PATHS+=("${candidate_path}")
}

add_unique_path() {
  local array_name="$1"
  local candidate_path="$2"
  local existing_path=""
  local current_paths=()
  eval "current_paths=(\"\${${array_name}[@]}\")"
  for existing_path in "${current_paths[@]}"; do
    [[ "${existing_path}" == "${candidate_path}" ]] && return 0
  done
  eval "${array_name}+=(\"\${candidate_path}\")"
}

print_directory_selection() {
  local label="$1"
  if [[ ${#DIRECTORY_PATHS[@]} -eq 1 ]]; then
    echo "${label}: ${DIRECTORY_PATHS[0]}"
    return
  fi

  echo "${label} directories:"
  local selected_path=""
  for selected_path in "${DIRECTORY_PATHS[@]}"; do
    echo "  - ${selected_path}"
  done
}

directory_is_scannable() {
  local directory_path="$1"
  find "${directory_path}" -type f -print -quit >/dev/null 2>&1
}

classify_directory_scan_access() {
  SCANNABLE_DIRECTORY_PATHS=()
  UNSCANNABLE_DIRECTORY_PATHS=()

  local directory_path=""
  for directory_path in "${DIRECTORY_PATHS[@]}"; do
    if directory_is_scannable "${directory_path}"; then
      add_unique_path "SCANNABLE_DIRECTORY_PATHS" "${directory_path}"
    else
      add_unique_path "UNSCANNABLE_DIRECTORY_PATHS" "${directory_path}"
    fi
  done
}

print_unscannable_directory_warning() {
  [[ ${#UNSCANNABLE_DIRECTORY_PATHS[@]} -eq 0 ]] && return 0

  echo "WARNING: Unable to scan source directories:"
  local directory_path=""
  for directory_path in "${UNSCANNABLE_DIRECTORY_PATHS[@]}"; do
    echo "  - ${directory_path}"
  done
}

build_multi_directory_playlist_id() {
  if ! filters_enabled; then
    printf '%s\n' "${DIRECTORY_PATHS[@]}" | LC_ALL=C sort | cksum | awk '{print $1}'
    return 0
  fi

  {
    printf 'paths\n'
    printf '%s\n' "${DIRECTORY_PATHS[@]}" | LC_ALL=C sort
    printf 'filters\n'
    printf '%s\n' "${ARG_FILTERS[@]}" | LC_ALL=C sort
  } | cksum | awk '{print $1}'
}

filters_enabled() {
  [[ ${#ARG_FILTERS[@]} -gt 0 ]]
}

configure_playlist_storage() {
  if [[ ${#DIRECTORY_PATHS[@]} -eq 1 ]]; then
    PLAYLIST_STORAGE_MODE="relative"
    PLAYLIST_BASE_DIR="${DIRECTORY_PATH}"
    if filters_enabled; then
      local filtered_playlist_id=""
      filtered_playlist_id="$(build_multi_directory_playlist_id)"
      PLAYLIST_FILE="${DIRECTORY_PATH}/.roulette_playlist-filter-${filtered_playlist_id}"
      PLAYED_FILE="${DIRECTORY_PATH}/.roulette_played-filter-${filtered_playlist_id}"
    else
      PLAYLIST_FILE="${DIRECTORY_PATH}/.roulette_playlist"
      PLAYED_FILE="${DIRECTORY_PATH}/.roulette_played"
    fi
    return
  fi

  PLAYLIST_STORAGE_MODE="absolute"
  PLAYLIST_BASE_DIR=""
  PLAYLIST_FILE="${XDG_STATE_HOME:-${HOME}/.local/state}/roulette/playlist-$(build_multi_directory_playlist_id).txt"
  PLAYED_FILE="${XDG_STATE_HOME:-${HOME}/.local/state}/roulette/played-$(build_multi_directory_playlist_id).txt"
  echo "Using shared playlist: ${PLAYLIST_FILE}"
}

check_and_install_mpv() {
  # Prefer PATH mpv if available (helps testing and custom installs)
  if command -v mpv &>/dev/null; then
    MPV_PATH="$(command -v mpv)"
    echo "mpv found in PATH: ${MPV_PATH}"
    return 0
  fi
  if [[ "${IS_WSL}" == true ]]; then
    local win_mpv_paths=(
      "/mnt/c/Program Files/mpv/mpv.exe"
      "/mnt/c/Program Files (x86)/mpv/mpv.exe"
      "/mnt/c/Users/${USER}/AppData/Local/Programs/mpv.net/mpvnet.exe"
      "$(command -v mpv.exe 2>/dev/null)"
    )

    for path in "${win_mpv_paths[@]}"; do
      if [[ -f "${path}" ]]; then
        MPV_PATH="${path}"
        echo "Found Windows MPV at: ${MPV_PATH}"
        return 0
      fi
    done

    echo "ERROR: mpv.exe not found on Windows side."
    echo "Please install mpv for Windows from https://mpv.io/installation/"
    echo "Or ensure mpv.exe is in your Windows PATH."
    exit 1
  fi

  if [[ -f "${MPV_PATH}" ]] || [[ -f "${MPV_PATH_ARM}" ]]; then
    echo "mpv is already installed."
    if [[ -f "${MPV_PATH_ARM}" ]]; then
      MPV_PATH="${MPV_PATH_ARM}"
    fi
  else
    echo "mpv is not installed. Installing using Homebrew..."
    if ! command -v brew &>/dev/null; then
      echo "Homebrew is not installed. Please install Homebrew first:"
      echo "Visit https://brew.sh for installation instructions"
      exit 1
    fi
    if brew install mpv; then
      echo "mpv installed successfully."
      if [[ -f "${MPV_PATH_ARM}" ]]; then
        MPV_PATH="${MPV_PATH_ARM}"
      fi
    else
      echo "Failed to install mpv using Homebrew. Please install it manually."
      exit 1
    fi
  fi
}

convert_path_for_mpv() {
  local path="$1"
  # Only convert to Windows path if using Windows mpv.exe
  if [[ "${IS_WSL}" == true ]] && [[ "${MPV_PATH}" == *.exe ]]; then
    wslpath -w "${path}"
  else
    echo "${path}"
  fi
}

# Playback progress tracking
LAST_PLAYBACK_PERCENT=0
LAST_MPV_OUTPUT=""
LAST_OPEN_VIDEO_WAS_STALE=false

# Threshold for considering a video "watched" (percentage)
WATCHED_THRESHOLD_PERCENT=10

build_mpv_args() {
  local mpv_opts=()
  local mpv_geometry="${MPV_GEOMETRY:-}"
  local mpv_volume="${MPV_VOLUME:-}"
  local mpv_fullscreen="${MPV_FULLSCREEN:-}"

  if [[ -n "${ARG_IGNORE_MPV_ENV}" ]]; then
    debug_log "Ignoring MPV_* environment variables due to --bypass"
    mpv_geometry=""
    mpv_volume=""
    mpv_fullscreen=""
  fi

  debug_log "Building mpv args: geometry='${mpv_geometry}' volume='${mpv_volume}' fullscreen_env='${mpv_fullscreen}' ARG_FULLSCREEN='${ARG_FULLSCREEN}'"

  # WSL with Linux mpv: use gpu-next to reduce exit crashes
  if [[ "${IS_WSL}" == true ]] && [[ "${MPV_PATH}" != *.exe ]]; then
    mpv_opts+=("--vo=gpu-next")
  fi

  if [[ -n "${mpv_geometry}" ]]; then
    mpv_opts+=("--geometry=${mpv_geometry}")
  fi
  if [[ -n "${mpv_volume}" ]]; then
    mpv_opts+=("--volume=${mpv_volume}")
  fi
  if [[ -n "${mpv_fullscreen}" || -n "${ARG_FULLSCREEN}" ]]; then
    mpv_opts+=("--fs")
  fi
  echo "${mpv_opts[@]}"
}

run_mpv() {
  local video_path="$1"
  local mpv_args
  mpv_args=$(build_mpv_args)

  debug_log "Executing: ${MPV_PATH} ${mpv_args} \"${video_path}\""

  # Reset playback tracking
  LAST_PLAYBACK_PERCENT=0
  LAST_MPV_OUTPUT=""

  # Run mpv and capture stderr to parse progress
  # mpv outputs status line like: AV: 00:00:02 / 00:39:45 (0%) A-V: -0.000
  local mpv_output
  local exit_code
  # shellcheck disable=SC2086  # mpv_args intentionally unquoted - empty string should expand to nothing
  if mpv_output=$("${MPV_PATH}" ${mpv_args} "${video_path}" 2>&1); then
    exit_code=0
  else
    exit_code=$?
  fi

  refocus_terminal

  # Treat segfault on exit as success (common WSL mpv issue)
  if [[ "${IS_WSL}" == true ]] && [[ ${exit_code} -eq 139 ]]; then
    exit_code=0
  fi

  # Parse the last AV line for progress percentage
  local percent
  percent=$(printf '%s\n' "${mpv_output}" | sed -n 's/.*(\([0-9][0-9]*\)%).*/\1/p' | tail -1)
  if [[ -n "${percent}" ]]; then
    LAST_PLAYBACK_PERCENT="${percent}"
  fi

  LAST_MPV_OUTPUT="${mpv_output}"

  debug_log "mpv exited with code ${exit_code}, playback: ${LAST_PLAYBACK_PERCENT}%"
  return ${exit_code}
}

is_video_watched_enough() {
  [[ ${LAST_PLAYBACK_PERCENT} -ge ${WATCHED_THRESHOLD_PERCENT} ]]
}

persist_video_state_if_needed() {
  local video_state="$1"
  local random_video="$2"

  case "${video_state}" in
    watched)
      mark_video_as_played "${random_video}"
      save_state_files
      ;;
    deleted)
      remove_video_from_state "${random_video}"
      save_state_files
      ;;
  esac
}

try_refill_playlist() {
  local previous_count=${#PLAYLIST[@]}
  scan_requested || return 1
  [[ ${#SCANNABLE_DIRECTORY_PATHS[@]} -gt 0 ]] || return 1

  resync_state_with_scan "$(scan_progress_label)"
  if [[ ${#PLAYLIST[@]} -gt ${previous_count} ]]; then
    save_state_files
    debug_log "Refilled playlist with $((${#PLAYLIST[@]} - previous_count)) new video(s)"
    return 0
  fi

  save_state_files
  return 1
}

list_videos() {
  [[ ${#SCANNABLE_DIRECTORY_PATHS[@]} -gt 0 ]] || return 1
  local directory_path=""
  local file_path=""
  for directory_path in "${SCANNABLE_DIRECTORY_PATHS[@]}"; do
    while IFS= read -r -d '' file_path; do
      printf '%s\0' "${file_path}"
    done < <(find_matching_videos "${directory_path}")
  done
}

print_filter_selection() {
  filters_enabled || return 0

  if [[ ${#ARG_FILTERS[@]} -eq 1 ]]; then
    echo "Filtering scan by: ${ARG_FILTERS[0]}"
    return 0
  fi

  echo "Filtering scan by:"
  local filter=""
  for filter in "${ARG_FILTERS[@]}"; do
    echo "  - ${filter}"
  done
}

scan_requested() {
  [[ -n "${ARG_SCAN}" ]]
}

no_videos_found_message() {
  if filters_enabled; then
    echo "No video files matched filter."
  else
    echo "No video files found."
  fi
}

scan_label_for_sources() {
  if filters_enabled; then
    if [[ ${#DIRECTORY_PATHS[@]} -eq 1 ]]; then
      echo "Scanning filtered directory: ${DIRECTORY_PATH}"
    else
      echo "Scanning ${#DIRECTORY_PATHS[@]} directories with filters..."
    fi
    return 0
  fi

  if [[ ${#DIRECTORY_PATHS[@]} -eq 1 ]]; then
    echo "Scanning directory: ${DIRECTORY_PATH}"
  else
    echo "Scanning ${#DIRECTORY_PATHS[@]} directories..."
  fi
}

scan_progress_label() {
  if filters_enabled; then
    printf '%s\n' "Scanning filters"
  else
    printf '%s\n' "Scanning library"
  fi
}

format_found_videos_message() {
  local count="$1"
  if filters_enabled; then
    echo "Found ${count} filtered videos, saved playlist."
  else
    echo "Found ${count} videos, saved playlist."
  fi
}

filter_storage_notice() {
  filters_enabled || return 0
  echo "Using filtered playlist: ${PLAYLIST_FILE}"
}

describe_filter_debug() {
  filters_enabled || return 0
  debug_log "Filters: ${ARG_FILTERS[*]}"
}

progress_output_enabled() {
  [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]
}

draw_progress_bar() {
  local label="$1"
  local processed="$2"
  local total="$3"
  local extra="$4"
  local width=28
  local percent=100
  local filled=0
  local empty=0
  local bar=""

  progress_output_enabled || return 0

  if [[ ${total} -gt 0 ]]; then
    percent=$((processed * 100 / total))
  fi
  ((percent > 100)) && percent=100

  filled=$((percent * width / 100))
  empty=$((width - filled))
  printf -v bar '%*s' "${filled}" ''
  bar="${bar// /=}"
  if [[ ${empty} -gt 0 ]]; then
    local padding=""
    printf -v padding '%*s' "${empty}" ''
    padding="${padding// /.}"
    bar="${bar}${padding}"
  fi

  printf '\r\033[2K%s [%s] %3d%% | %s/%s%s' \
    "${label}" "${bar}" "${percent}" "${processed}" "${total}" "${extra}" >&2
}

finish_progress_bar() {
  progress_output_enabled || return 0
  printf '\n' >&2
}

is_supported_video_path() {
  local file_path="$1"
  local extension="${file_path##*.}"
  extension=$(printf '%s' "${extension}" | tr '[:upper:]' '[:lower:]')
  local known_extension=""

  for known_extension in "${VIDEO_EXTENSIONS[@]}"; do
    if [[ "${extension}" == "${known_extension}" ]]; then
      return 0
    fi
  done
  return 1
}

stream_video_candidates_with_find() {
  local directory_path="$1"
  local find_args=(find "${directory_path}" -type f '(')
  local i=0
  local ext=""

  for ((i = 0; i < ${#VIDEO_EXTENSIONS[@]}; i++)); do
    ext="${VIDEO_EXTENSIONS[${i}]}"
    find_args+=(-iname "*.${ext}")
    if ((i < ${#VIDEO_EXTENSIONS[@]} - 1)); then
      find_args+=(-o)
    fi
  done
  find_args+=(')')
  find_args+=(-print0)
  "${find_args[@]}"
}

stream_video_candidates_with_fd() {
  local scanner_path="$1"
  local directory_path="$2"
  local scanner_args=(
    "${scanner_path}"
    --type f
    --hidden
    --no-ignore
    --print0
  )
  local extension=""

  for extension in "${VIDEO_EXTENSIONS[@]}"; do
    scanner_args+=(--extension "${extension}")
  done

  scanner_args+=(. "${directory_path}")
  "${scanner_args[@]}"
}

find_matching_videos() {
  local directory_path="$1"
  local scanner_path=""
  local file_path=""
  local relative_path=""
  local filter=""
  local filter_matched=false
  local restore_nocasematch=false

  if [[ -z "${ROULETTE_DISABLE_FD:-}" ]]; then
    scanner_path="$(command -v fd 2>/dev/null || command -v fdfind 2>/dev/null || true)"
  fi

  if filters_enabled && ! shopt -q nocasematch; then
    shopt -s nocasematch
    restore_nocasematch=true
  fi

  if [[ -n "${scanner_path}" ]]; then
    while IFS= read -r -d '' file_path; do
      relative_path="${file_path#"${directory_path}/"}"
      if filters_enabled; then
        filter_matched=false
        for filter in "${ARG_FILTERS[@]}"; do
          if [[ "${relative_path}" == *"${filter}"* ]]; then
            filter_matched=true
            break
          fi
        done
        [[ "${filter_matched}" == true ]] || continue
      fi
      printf '%s\0' "${file_path}"
    done < <(stream_video_candidates_with_fd "${scanner_path}" "${directory_path}")
  else
    while IFS= read -r -d '' file_path; do
      relative_path="${file_path#"${directory_path}/"}"
      if filters_enabled; then
        filter_matched=false
        for filter in "${ARG_FILTERS[@]}"; do
          if [[ "${relative_path}" == *"${filter}"* ]]; then
            filter_matched=true
            break
          fi
        done
        [[ "${filter_matched}" == true ]] || continue
      fi
      printf '%s\0' "${file_path}"
    done < <(stream_video_candidates_with_find "${directory_path}")
  fi

  if [[ "${restore_nocasematch}" == true ]]; then
    shopt -u nocasematch
  fi
}

count_matching_videos() {
  local total_videos=0
  local indexed_dirs=0
  local directory_path=""
  local file_path=""

  [[ ${#SCANNABLE_DIRECTORY_PATHS[@]} -gt 0 ]] || {
    printf '0\n'
    return 0
  }

  for directory_path in "${SCANNABLE_DIRECTORY_PATHS[@]}"; do
    while IFS= read -r -d '' file_path; do
      total_videos=$((total_videos + 1))
    done < <(find_matching_videos "${directory_path}")

    indexed_dirs=$((indexed_dirs + 1))
    draw_progress_bar "Indexing scan" "${indexed_dirs}" "${#SCANNABLE_DIRECTORY_PATHS[@]}" " | ${total_videos} videos"
  done

  if [[ ${#SCANNABLE_DIRECTORY_PATHS[@]} -gt 0 ]]; then
    finish_progress_bar
  fi

  printf '%s\n' "${total_videos}"
}

scan_videos_with_progress() {
  local scan_label="${1:-Scanning library}"
  local matched_videos=0
  local directory_path=""
  local file_path=""

  SCANNED_VIDEOS=()
  [[ ${#SCANNABLE_DIRECTORY_PATHS[@]} -gt 0 ]] || return 0

  if progress_output_enabled; then
    printf '\r\033[2K%s | 0 videos found' "${scan_label}" >&2
  fi

  for directory_path in "${SCANNABLE_DIRECTORY_PATHS[@]}"; do
    while IFS= read -r -d '' file_path; do
      SCANNED_VIDEOS+=("${file_path}")
      matched_videos=$((matched_videos + 1))
      if progress_output_enabled; then
        printf '\r\033[2K%s | %s videos found' "${scan_label}" "${matched_videos}" >&2
      fi
    done < <(find_matching_videos "${directory_path}")
  done

  if progress_output_enabled; then
    finish_progress_bar
  fi
}

# Playlist management functions
PLAYLIST=()
PLAYED_HISTORY=()
SCANNED_VIDEOS=()
LAST_COMPACT_REMOVED_COUNT=0
STATE_DIRTY=false

# Convert absolute path to relative (for storing in playlist)
to_relative_path() {
  local absolute_path="$1"
  local base_dir="$2"
  # Remove the base directory prefix to get relative path
  echo "${absolute_path#"${base_dir}/"}"
}

serialize_path_for_storage() {
  local absolute_path="$1"
  local base_dir="$2"

  if [[ "${PLAYLIST_STORAGE_MODE}" != "relative" ]]; then
    printf '%s\n' "${absolute_path}"
    return 0
  fi

  if [[ "${absolute_path}" == "${base_dir}"/* ]]; then
    to_relative_path "${absolute_path}" "${base_dir}"
    return 0
  fi

  printf '%s%s\n' "${ABSOLUTE_STORAGE_PREFIX}" "${absolute_path}"
}

# Known base path patterns across different platforms
KNOWN_BASE_PATHS=(
  "/Volumes/media/archive/video"
  "/mnt/media/archive/video"
  "/media/archive/video"
  "/mnt/m/media/archive/video"
)

# Convert relative path to absolute (for playback)
to_absolute_path() {
  local relative_path="$1"
  local base_dir="$2"

  # If not absolute, just prepend base_dir
  if [[ "${relative_path}" != /* ]]; then
    echo "${base_dir}/${relative_path}"
    return
  fi

  # Path is absolute - check if it's from a different platform's base path
  for known_base in "${KNOWN_BASE_PATHS[@]}"; do
    if [[ "${relative_path}" == "${known_base}/"* ]]; then
      # Strip the old base and use current base
      local suffix="${relative_path#"${known_base}/"}"
      echo "${base_dir}/${suffix}"
      return
    fi
  done

  # Unknown absolute path - return as-is (legacy fallback)
  echo "${relative_path}"
}

deserialize_stored_path() {
  local stored_path="$1"
  local base_dir="$2"

  if [[ "${PLAYLIST_STORAGE_MODE}" != "relative" ]]; then
    printf '%s\n' "${stored_path}"
    return 0
  fi

  if [[ "${stored_path}" == "${ABSOLUTE_STORAGE_PREFIX}"* ]]; then
    printf '%s\n' "${stored_path#"${ABSOLUTE_STORAGE_PREFIX}"}"
    return 0
  fi

  to_absolute_path "${stored_path}" "${base_dir}"
}

load_playlist() {
  local playlist_file="$1"
  local base_dir="$2"
  debug_log "Loading playlist from: ${playlist_file} (base: ${base_dir})"
  PLAYLIST=()
  [[ ! -f "${playlist_file}" ]] && return 1
  while IFS= read -r line; do
    if [[ -n "${line}" ]]; then
      local absolute_path=""
      absolute_path=$(deserialize_stored_path "${line}" "${base_dir}")
      PLAYLIST+=("${absolute_path}")
    fi
  done <"${playlist_file}"
  debug_log "Loaded ${#PLAYLIST[@]} entries from playlist"
  return 0
}

PLAYED_FILE=""

save_playlist() {
  local playlist_file="$1"
  local base_dir="$2"
  debug_log "Saving playlist to: ${playlist_file} (${#PLAYLIST[@]} entries, base: ${base_dir})"
  mkdir -p "$(dirname "${playlist_file}")"
  local stored_path=""
  for video in "${PLAYLIST[@]}"; do
    stored_path=$(serialize_path_for_storage "${video}" "${base_dir}")
    printf '%s\n' "${stored_path}"
  done >"${playlist_file}"
}

load_played_history() {
  local played_file="$1"
  local base_dir="$2"
  debug_log "Loading played history from: ${played_file} (base: ${base_dir})"
  PLAYED_HISTORY=()
  [[ ! -f "${played_file}" ]] && return 1
  while IFS= read -r line; do
    if [[ -n "${line}" ]]; then
      local absolute_path=""
      absolute_path=$(deserialize_stored_path "${line}" "${base_dir}")
      PLAYED_HISTORY+=("${absolute_path}")
    fi
  done <"${played_file}"
  debug_log "Loaded ${#PLAYED_HISTORY[@]} entries from played history"
  return 0
}

save_played_history() {
  local played_file="$1"
  local base_dir="$2"
  debug_log "Saving played history to: ${played_file} (${#PLAYED_HISTORY[@]} entries, base: ${base_dir})"
  mkdir -p "$(dirname "${played_file}")"
  local stored_path=""
  for video in "${PLAYED_HISTORY[@]}"; do
    stored_path=$(serialize_path_for_storage "${video}" "${base_dir}")
    printf '%s\n' "${stored_path}"
  done >"${played_file}"
}

mark_state_dirty() {
  STATE_DIRTY=true
}

state_files_missing() {
  [[ ! -f "${PLAYLIST_FILE}" ]] || [[ ! -f "${PLAYED_FILE}" ]]
}

path_in_array() {
  local array_name="$1"
  local candidate_path="$2"
  local current_paths=()
  local existing_path=""

  eval "current_paths=(\"\${${array_name}[@]}\")"
  for existing_path in "${current_paths[@]}"; do
    [[ "${existing_path}" == "${candidate_path}" ]] && return 0
  done
  return 1
}

remove_path_from_array() {
  local array_name="$1"
  local path_to_remove="$2"
  local current_paths=()
  local updated_paths=()
  local existing_path=""

  eval "current_paths=(\"\${${array_name}[@]}\")"
  for existing_path in "${current_paths[@]}"; do
    [[ "${existing_path}" != "${path_to_remove}" ]] && updated_paths+=("${existing_path}")
  done
  eval "${array_name}=()"
  for existing_path in "${updated_paths[@]}"; do
    eval "${array_name}+=(\"\${existing_path}\")"
  done
}

add_path_if_missing() {
  local array_name="$1"
  local candidate_path="$2"
  if ! path_in_array "${array_name}" "${candidate_path}"; then
    eval "${array_name}+=(\"\${candidate_path}\")"
  fi
}

remove_from_playlist() {
  local video_to_remove="$1"
  debug_log "Removing from playlist: ${video_to_remove}"
  remove_path_from_array "PLAYLIST" "${video_to_remove}"
  debug_log "Playlist now has ${#PLAYLIST[@]} entries"
}

remove_from_played_history() {
  local video_to_remove="$1"
  debug_log "Removing from played history: ${video_to_remove}"
  remove_path_from_array "PLAYED_HISTORY" "${video_to_remove}"
  debug_log "Played history now has ${#PLAYED_HISTORY[@]} entries"
}

# Check if a video file exists
validate_video_file() {
  local video_path="$1"
  [[ -f "${video_path}" ]]
}

path_should_skip_validation() {
  local video_path="$1"
  local directory_path=""
  for directory_path in "${UNSCANNABLE_DIRECTORY_PATHS[@]}"; do
    if video_matches_directory "${video_path}" "${directory_path}"; then
      return 0
    fi
  done
  return 1
}

path_is_in_unscannable_directory() {
  local video_path="$1"
  path_should_skip_validation "${video_path}"
}

playlist_entry_is_selectable() {
  local video_path="$1"
  ! path_is_in_unscannable_directory "${video_path}"
}

count_selectable_playlist_videos() {
  local count=0
  local video=""

  for video in "${PLAYLIST[@]}"; do
    if playlist_entry_is_selectable "${video}"; then
      count=$((count + 1))
    fi
  done

  printf '%s\n' "${count}"
}

compact_tracked_paths() {
  local array_name="$1"
  local current_paths=()
  local compacted_paths=()
  local video_path=""
  local removed_count=0

  eval "current_paths=(\"\${${array_name}[@]}\")"
  for video_path in "${current_paths[@]}"; do
    [[ -n "${video_path}" ]] || continue
    if path_in_array "compacted_paths" "${video_path}"; then
      continue
    fi
    if path_should_skip_validation "${video_path}" || validate_video_file "${video_path}"; then
      compacted_paths+=("${video_path}")
    else
      removed_count=$((removed_count + 1))
    fi
  done

  eval "${array_name}=()"
  for video_path in "${compacted_paths[@]}"; do
    eval "${array_name}+=(\"\${video_path}\")"
  done

  LAST_COMPACT_REMOVED_COUNT="${removed_count}"
}

refresh_scanned_videos() {
  local scan_label="${1:-Scanning library}"
  scan_videos_with_progress "${scan_label}"
}

write_path_array_file() {
  local array_name="$1"
  local output_file="$2"
  local paths=()
  local path=""

  eval "paths=(\"\${${array_name}[@]}\")"
  {
    for path in "${paths[@]}"; do
      [[ -n "${path}" ]] && printf '%s\n' "${path}"
    done
  } >"${output_file}"
}

load_path_array_file() {
  local array_name="$1"
  local input_file="$2"
  local path=""

  eval "${array_name}=()"
  while IFS= read -r path; do
    [[ -n "${path}" ]] || continue
    eval "${array_name}+=(\"\${path}\")"
  done <"${input_file}"
}

reconcile_tracked_path_file() {
  local input_file="$1"
  local output_file="$2"
  local scanned_file="$3"
  local scannable_directories_file="$4"
  local unscannable_directories_file="$5"
  local stale_count_file="$6"

  LC_ALL=C awk \
    -v scanned_file="${scanned_file}" \
    -v scannable_file="${scannable_directories_file}" \
    -v unscannable_file="${unscannable_directories_file}" \
    -v stale_count_file="${stale_count_file}" '
      function path_is_within(path, directories, directory_count,    i, prefix) {
        for (i = 1; i <= directory_count; i++) {
          prefix = directories[i] "/"
          if (index(path, prefix) == 1) {
            return 1
          }
        }
        return 0
      }

      BEGIN {
        while ((getline line < scanned_file) > 0) {
          scanned[line] = 1
        }
        close(scanned_file)

        while ((getline line < scannable_file) > 0) {
          scannable[++scannable_count] = line
        }
        close(scannable_file)

        while ((getline line < unscannable_file) > 0) {
          unscannable[++unscannable_count] = line
        }
        close(unscannable_file)
      }

      length($0) > 0 && !retained[$0]++ {
        if (path_is_within($0, unscannable, unscannable_count) ||
            !path_is_within($0, scannable, scannable_count) ||
            ($0 in scanned)) {
          print
        } else {
          stale_count++
        }
      }

      END {
        print stale_count + 0 > stale_count_file
      }
    ' "${input_file}" >"${output_file}"
}

reconcile_state_from_scan() {
  local sync_dir=""
  local scanned_file=""
  local playlist_input_file=""
  local playlist_output_file=""
  local played_input_file=""
  local played_output_file=""
  local scannable_file=""
  local unscannable_file=""
  local playlist_stale_file=""
  local played_stale_file=""
  local new_count_file=""

  sync_dir="$(mktemp -d "${TMPDIR:-/tmp}/roulette-sync.XXXXXX")" || return 1
  scanned_file="${sync_dir}/scanned"
  playlist_input_file="${sync_dir}/playlist-input"
  playlist_output_file="${sync_dir}/playlist-output"
  played_input_file="${sync_dir}/played-input"
  played_output_file="${sync_dir}/played-output"
  scannable_file="${sync_dir}/scannable"
  unscannable_file="${sync_dir}/unscannable"
  playlist_stale_file="${sync_dir}/playlist-stale-count"
  played_stale_file="${sync_dir}/played-stale-count"
  new_count_file="${sync_dir}/new-count"

  write_path_array_file "SCANNED_VIDEOS" "${scanned_file}"
  write_path_array_file "PLAYLIST" "${playlist_input_file}"
  write_path_array_file "PLAYED_HISTORY" "${played_input_file}"
  write_path_array_file "SCANNABLE_DIRECTORY_PATHS" "${scannable_file}"
  write_path_array_file "UNSCANNABLE_DIRECTORY_PATHS" "${unscannable_file}"

  reconcile_tracked_path_file \
    "${playlist_input_file}" \
    "${playlist_output_file}" \
    "${scanned_file}" \
    "${scannable_file}" \
    "${unscannable_file}" \
    "${playlist_stale_file}"
  reconcile_tracked_path_file \
    "${played_input_file}" \
    "${played_output_file}" \
    "${scanned_file}" \
    "${scannable_file}" \
    "${unscannable_file}" \
    "${played_stale_file}"

  LC_ALL=C awk \
    -v playlist_file="${playlist_output_file}" \
    -v played_file="${played_output_file}" \
    -v new_count_file="${new_count_file}" '
      BEGIN {
        while ((getline line < playlist_file) > 0) {
          playlist[line] = 1
        }
        close(playlist_file)

        while ((getline line < played_file) > 0) {
          played[line] = 1
        }
        close(played_file)
      }

      length($0) > 0 && !($0 in playlist) && !($0 in played) {
        print
        playlist[$0] = 1
        new_count++
      }

      END {
        print new_count + 0 > new_count_file
      }
    ' "${scanned_file}" >>"${playlist_output_file}"

  load_path_array_file "PLAYLIST" "${playlist_output_file}"
  load_path_array_file "PLAYED_HISTORY" "${played_output_file}"
  RECONCILED_PLAYLIST_STALE_COUNT="$(<"${playlist_stale_file}")"
  RECONCILED_PLAYED_STALE_COUNT="$(<"${played_stale_file}")"
  RECONCILED_NEW_COUNT="$(<"${new_count_file}")"

  rm -rf "${sync_dir}"
}

resync_state_with_scan() {
  local scan_label="${1:-Scanning library}"
  local playlist_stale_count=0
  local played_stale_count=0
  local new_count=0

  refresh_scanned_videos "${scan_label}"
  reconcile_state_from_scan
  playlist_stale_count="${RECONCILED_PLAYLIST_STALE_COUNT}"
  played_stale_count="${RECONCILED_PLAYED_STALE_COUNT}"
  new_count="${RECONCILED_NEW_COUNT}"

  if [[ ${playlist_stale_count} -gt 0 ]] || [[ ${played_stale_count} -gt 0 ]] || [[ ${new_count} -gt 0 ]]; then
    mark_state_dirty
  fi

  debug_log "Resynced state: removed ${playlist_stale_count} stale playlist entries, ${played_stale_count} stale played entries, added ${new_count} new video(s)"
}

save_state_files() {
  if [[ "${STATE_DIRTY}" != true ]] && ! state_files_missing; then
    debug_log "State unchanged, skipping save"
    return 0
  fi

  save_playlist "${PLAYLIST_FILE}" "${PLAYLIST_BASE_DIR}"
  save_played_history "${PLAYED_FILE}" "${PLAYLIST_BASE_DIR}"
  STATE_DIRTY=false
}

mark_video_as_played() {
  local video_path="$1"
  local playlist_count_before=${#PLAYLIST[@]}
  local played_count_before=${#PLAYED_HISTORY[@]}
  remove_from_playlist "${video_path}"
  add_path_if_missing "PLAYED_HISTORY" "${video_path}"
  if [[ ${#PLAYLIST[@]} -ne ${playlist_count_before} ]] || [[ ${#PLAYED_HISTORY[@]} -ne ${played_count_before} ]]; then
    mark_state_dirty
  fi
}

remove_video_from_state() {
  local video_path="$1"
  local playlist_count_before=${#PLAYLIST[@]}
  local played_count_before=${#PLAYED_HISTORY[@]}
  remove_from_playlist "${video_path}"
  remove_from_played_history "${video_path}"
  if [[ ${#PLAYLIST[@]} -ne ${playlist_count_before} ]] || [[ ${#PLAYED_HISTORY[@]} -ne ${played_count_before} ]]; then
    mark_state_dirty
  fi
}

promote_source_root_for_video() {
  local video_path="$1"
  local directory_path=""

  if [[ -n "${PROMOTE_DOWNLOADS_PATH}" ]] && video_matches_directory "${video_path}" "${PROMOTE_DOWNLOADS_PATH}"; then
    printf '%s\n' "${PROMOTE_DOWNLOADS_PATH}"
    return 0
  fi

  for directory_path in "${DIRECTORY_PATHS[@]}"; do
    if [[ "${directory_path}" != "${PROMOTE_MAIN_PATH}" ]] && video_matches_directory "${video_path}" "${directory_path}"; then
      printf '%s\n' "${directory_path}"
      return 0
    fi
  done

  return 1
}

build_promoted_video_path() {
  local video_path="$1"
  local source_root=""
  local relative_suffix=""

  source_root=$(promote_source_root_for_video "${video_path}") || return 1
  [[ -n "${PROMOTE_MAIN_PATH}" ]] || return 1

  relative_suffix="${video_path#"${source_root}/"}"
  printf '%s\n' "${PROMOTE_MAIN_PATH}/${relative_suffix}"
}

promote_video_to_main() {
  local video_path="$1"
  local destination_path=""

  if [[ -z "${PROMOTE_MAIN_PATH}" ]]; then
    echo -e "${YELLOW}Promote paths not configured.${NC}"
    return 1
  fi

  if ! promote_source_root_for_video "${video_path}" >/dev/null; then
    echo -e "${YELLOW}Promote only works for files in a configured source path.${NC}"
    return 1
  fi

  destination_path=$(build_promoted_video_path "${video_path}") || {
    echo -e "${RED}Failed to build promoted path.${NC}"
    return 1
  }

  if [[ "${destination_path}" == "${video_path}" ]]; then
    echo -e "${YELLOW}Promote destination matches source.${NC}"
    return 1
  fi

  if [[ -e "${destination_path}" ]]; then
    echo -e "${RED}Promote target already exists:${NC} ${destination_path}"
    return 1
  fi

  if ! mkdir -p "$(dirname "${destination_path}")"; then
    echo -e "${RED}Failed to create destination directory.${NC}"
    return 1
  fi

  if ! mv "${video_path}" "${destination_path}" 2>/dev/null; then
    echo -e "${RED}Failed to move file.${NC} Check permissions."
    return 1
  fi

  remove_from_playlist "${video_path}"
  remove_from_played_history "${video_path}"
  remove_from_playlist "${destination_path}"
  add_path_if_missing "PLAYED_HISTORY" "${destination_path}"
  mark_state_dirty
  save_state_files

  echo -e "${GREEN}Promoted:${NC} ${destination_path}"
  return 0
}

count_playlist_videos_for_directory() {
  local directory_path="$1"
  local count=0
  local video=""
  for video in "${PLAYLIST[@]}"; do
    if video_matches_directory "${video}" "${directory_path}" && playlist_entry_is_selectable "${video}"; then
      count=$((count + 1))
    fi
  done
  printf '%s\n' "${count}"
}

print_playlist_directory_counts() {
  [[ ${#DIRECTORY_PATHS[@]} -gt 0 ]] || return 0

  echo "Video counts by directory:"
  local directory_path=""
  local count=0
  for directory_path in "${DIRECTORY_PATHS[@]}"; do
    count=$(count_playlist_videos_for_directory "${directory_path}")
    echo "  - ${directory_path}: ${count}"
  done
}

video_matches_directory() {
  local video_path="$1"
  local directory_path="$2"
  case "${video_path}" in
    "${directory_path}"/*) return 0 ;;
    *) return 1 ;;
  esac
}

select_playlist_index() {
  if [[ ${#PLAYLIST[@]} -eq 0 ]]; then
    return 1
  fi

  local selected_index=-1
  local selectable_indexes=()
  local i

  for ((i = 0; i < ${#PLAYLIST[@]}; i++)); do
    if playlist_entry_is_selectable "${PLAYLIST[${i}]}"; then
      selectable_indexes+=("${i}")
    fi
  done

  if [[ ${#selectable_indexes[@]} -eq 0 ]]; then
    debug_log "No selectable playlist entries in currently scannable directories"
    return 1
  fi

  if [[ -n "${ARG_SHUFFLE}" ]] || [[ ${#DIRECTORY_PATHS[@]} -le 1 ]]; then
    selected_index="${selectable_indexes[$((RANDOM % ${#selectable_indexes[@]}))]}"
    debug_log "Shuffle selection enabled, chose index ${selected_index} of ${#selectable_indexes[@]} selectable entries"
    printf '%s\n' "${selected_index}"
    return 0
  fi

  local directory_path=""
  local candidate_indexes=()
  for directory_path in "${DIRECTORY_PATHS[@]}"; do
    candidate_indexes=()
    for ((i = 0; i < ${#PLAYLIST[@]}; i++)); do
      if video_matches_directory "${PLAYLIST[${i}]}" "${directory_path}" && playlist_entry_is_selectable "${PLAYLIST[${i}]}"; then
        candidate_indexes+=("${i}")
      fi
    done

    if [[ ${#candidate_indexes[@]} -gt 0 ]]; then
      selected_index="${candidate_indexes[$((RANDOM % ${#candidate_indexes[@]}))]}"
      debug_log "Directory-priority selection chose index ${selected_index} from ${#candidate_indexes[@]} candidate(s) in ${directory_path}"
      printf '%s\n' "${selected_index}"
      return 0
    fi
  done

  selected_index="${selectable_indexes[$((RANDOM % ${#selectable_indexes[@]}))]}"
  debug_log "No configured directory match found, falling back to shuffled selectable index ${selected_index}"
  printf '%s\n' "${selected_index}"
}

# Clean stale entries from playlist and exit
clean_playlist() {
  local total_count=${#PLAYLIST[@]}
  local total_played_count=${#PLAYED_HISTORY[@]}
  local stale_playlist_count=0
  local stale_played_count=0

  # Check if playlist is empty
  if [[ ${total_count} -eq 0 ]] && [[ ${total_played_count} -eq 0 ]]; then
    echo "No playlist found. Run without --clean to scan and create a playlist first."
    exit 0
  fi

  debug_log "Starting state cleaning (${total_count} playlist entries, ${total_played_count} played entries)"
  echo "Validating tracked videos..."

  compact_tracked_paths "PLAYLIST"
  stale_playlist_count="${LAST_COMPACT_REMOVED_COUNT}"
  compact_tracked_paths "PLAYED_HISTORY"
  stale_played_count="${LAST_COMPACT_REMOVED_COUNT}"
  if [[ ${stale_playlist_count} -gt 0 ]] || [[ ${stale_played_count} -gt 0 ]]; then
    mark_state_dirty
  fi
  save_state_files

  # Report results
  local remaining_count=${#PLAYLIST[@]}
  local remaining_played_count=${#PLAYED_HISTORY[@]}
  local stale_count=$((stale_playlist_count + stale_played_count))
  echo ""
  if [[ ${stale_count} -eq 0 ]]; then
    echo -e "${GREEN}State is clean - ${remaining_count} playlist videos and ${remaining_played_count} played videos exist.${NC}"
  else
    echo -e "${GREEN}Cleaned ${stale_count} stale entries, ${remaining_count} playlist videos and ${remaining_played_count} played videos remaining.${NC}"
  fi

  exit 0
}

if [[ -n "${ROULETTE_SOURCE_ONLY:-}" ]]; then
  if (return 0 2>/dev/null); then
    return 0
  fi
  exit 0
fi

# === MAIN ===

parse_args "$@"

echo -e "${GREEN}"
print_logo
echo "   r o u l e t t e"
echo "   Version ${VERSION}"
echo ""
echo -e "${NC}"

USER_PROVIDED_PATH=""

detect_macos
detect_wsl

if [[ ${#ARG_DIRECTORIES[@]} -gt 0 ]]; then
  DIRECTORY_PATHS=()
  for USER_PROVIDED_PATH in "${ARG_DIRECTORIES[@]}"; do
    local_normalized_path=""
    if ! local_normalized_path=$(normalize_directory_path "${USER_PROVIDED_PATH}"); then
      echo -e "${RED}ERROR:${NC} Directory not found: ${USER_PROVIDED_PATH/#\~/${HOME}}"
      exit 1
    fi
    add_directory_path "${local_normalized_path}"
  done
  DIRECTORY_PATH="${DIRECTORY_PATHS[0]}"
  print_directory_selection "Using provided"
else
  detect_media_directory
fi

print_filter_selection

check_and_install_mpv

classify_directory_scan_access

configure_playlist_storage
filter_storage_notice
configure_promote_paths
describe_filter_debug

# Load or create playlist
playlist_loaded=false
played_history_loaded=false
selectable_playlist_count=0

if [[ -z "${ARG_RESET}" ]]; then
  if load_playlist "${PLAYLIST_FILE}" "${PLAYLIST_BASE_DIR}"; then
    playlist_loaded=true
  fi
  if load_played_history "${PLAYED_FILE}" "${PLAYLIST_BASE_DIR}"; then
    played_history_loaded=true
  fi
fi

if [[ -n "${ARG_RESET}" ]]; then
  if [[ -n "${ARG_RESET}" ]]; then
    debug_log "Reset flag provided, rebuilding playlist"
  fi
  if [[ ${#UNSCANNABLE_DIRECTORY_PATHS[@]} -gt 0 ]]; then
    print_unscannable_directory_warning
  fi
  if [[ ${#SCANNABLE_DIRECTORY_PATHS[@]} -eq 0 ]]; then
    echo -e "${RED}ERROR:${NC} None of the configured source directories are currently scannable."
    echo "Restore directory access and retry."
    exit 1
  fi

  PLAYLIST=()
  PLAYED_HISTORY=()
  mark_state_dirty
  scan_label_for_sources

  refresh_scanned_videos "$(scan_progress_label)"
  PLAYLIST=("${SCANNED_VIDEOS[@]}")
  if [[ ${#PLAYLIST[@]} -gt 0 ]]; then
    mark_state_dirty
  fi

  if [[ ${#PLAYLIST[@]} -eq 0 ]]; then
    save_state_files
    no_videos_found_message
    exit 0
  fi

  save_state_files
  format_found_videos_message "${#PLAYLIST[@]}"
  print_playlist_directory_counts
else
  if [[ ${#UNSCANNABLE_DIRECTORY_PATHS[@]} -gt 0 ]]; then
    print_unscannable_directory_warning
    if [[ "${playlist_loaded}" == true ]]; then
      if [[ -n "${ARG_SCAN}" ]]; then
        echo "Loaded playlist may be stale. New scan will skip inaccessible directories."
      else
        echo "Loaded playlist may be stale. Use --scan to refresh accessible directories."
      fi
    fi
  fi

  if [[ ${#SCANNABLE_DIRECTORY_PATHS[@]} -eq 0 ]]; then
    if [[ "${playlist_loaded}" == true ]]; then
      selectable_playlist_count=$(count_selectable_playlist_videos)
      echo "Loaded playlist: ${selectable_playlist_count} selectable videos remaining (${#PLAYLIST[@]} tracked)"
      print_playlist_directory_counts
      if [[ ${selectable_playlist_count} -eq 0 ]]; then
        echo -e "${RED}ERROR:${NC} No selectable videos remain while source directories are inaccessible."
        echo "Restore directory access and retry."
        exit 1
      fi
    else
      echo -e "${RED}ERROR:${NC} None of the configured source directories are currently scannable."
      echo "Restore directory access and retry."
      exit 1
    fi
  else
    if [[ "${playlist_loaded}" == true ]] && ! scan_requested; then
      selectable_playlist_count=$(count_selectable_playlist_videos)
      save_state_files
      echo "Loaded playlist: ${selectable_playlist_count} selectable videos remaining (${#PLAYLIST[@]} tracked)"
      print_playlist_directory_counts
    elif [[ "${playlist_loaded}" == true ]] || [[ "${played_history_loaded}" == true ]]; then
      resync_state_with_scan "$(scan_progress_label)"
      save_state_files

      if [[ "${playlist_loaded}" == true ]]; then
        selectable_playlist_count=$(count_selectable_playlist_videos)
        echo "Loaded playlist: ${selectable_playlist_count} selectable videos remaining (${#PLAYLIST[@]} tracked)"
      else
        echo "Loaded played history: ${#PLAYED_HISTORY[@]} videos tracked"
      fi
      print_playlist_directory_counts
    else
      scan_label_for_sources

      resync_state_with_scan "$(scan_progress_label)"
      if [[ ${#PLAYLIST[@]} -gt 0 ]]; then
        mark_state_dirty
      fi

      if [[ ${#PLAYLIST[@]} -eq 0 ]]; then
        no_videos_found_message
        exit 0
      fi

      save_state_files
      format_found_videos_message "${#PLAYLIST[@]}"
      print_playlist_directory_counts
    fi
  fi
fi

# If clean mode is enabled, validate and clean playlist then exit
if [[ -n "${ARG_CLEAN}" ]]; then
  clean_playlist
fi

open_random_video() {
  LAST_OPEN_VIDEO_WAS_STALE=false

  if [[ ${#PLAYLIST[@]} -eq 0 ]]; then
    if try_refill_playlist; then
      echo "Found new videos during rescan."
    else
      echo "Playlist empty - all videos played!"
      echo "Use --scan to look for new videos or --reset to rebuild the playlist."
      return 1
    fi
  fi

  local selectable_playlist_count=0
  selectable_playlist_count=$(count_selectable_playlist_videos)
  echo -e "${DIM}${selectable_playlist_count} selectable videos remaining (${#PLAYLIST[@]} tracked).${NC}"
  local random_index
  if ! random_index=$(select_playlist_index); then
    echo -e "${RED}No selectable videos available from currently accessible directories.${NC}"
    echo "Restore directory access and retry."
    return 1
  fi
  random_video="${PLAYLIST[${random_index}]}"
  debug_log "Selected index ${random_index} of ${#PLAYLIST[@]}: ${random_video}"

  # Verify file still exists
  if ! validate_video_file "${random_video}"; then
    debug_log "File not found, removing stale entry"
    echo "Video no longer exists, removing: ${random_video}"
    remove_from_playlist "${random_video}"
    save_state_files
    LAST_OPEN_VIDEO_WAS_STALE=true
    return 1
  fi

  echo -e "${ICON} Playing: ${random_video}"

  local video_path
  video_path=$(convert_path_for_mpv "${random_video}")
  run_mpv "${video_path}"
}

while true; do
  set +e
  open_random_video
  result=$?
  set -e

  if [[ "${LAST_OPEN_VIDEO_WAS_STALE}" == true ]]; then
    # File not found, auto-retry
    continue
  elif [[ ${result} -eq 0 ]]; then
    video_state="keep"

    # Check if video was watched enough to auto-remove
    if is_video_watched_enough; then
      echo ""
      echo -e "${GREEN}Video watched (${LAST_PLAYBACK_PERCENT}%)${NC} - removed from playlist."
      video_state="watched"
    else
      echo ""
      echo -e "${YELLOW}Video skipped (${LAST_PLAYBACK_PERCENT}%)${NC} - keeping in playlist."
    fi

    while true; do
      user_input=""
      echo ""
      drain_tty_input_buffer
      if [[ "${video_state}" == "watched" ]]; then
        echo -e -n "[${CYAN}q${NC}]uit  [${RED}d${NC}]elete  [${DIM}i${NC}]nfo  [${DIM}p${NC}]romote  [${DIM}r${NC}]eplay  [${DIM}u${NC}]ndo  [${GREEN}N${NC}]ext: "
      else
        echo -e -n "[${CYAN}q${NC}]uit  [${RED}d${NC}]elete  [${DIM}i${NC}]nfo  [${DIM}p${NC}]romote  [${DIM}r${NC}]eplay  [${GREEN}N${NC}]ext: "
      fi
      if ! read_single_key user_input; then
        echo ""
        persist_video_state_if_needed "${video_state}" "${random_video}"
        echo "Input closed. Goodbye!"
        exit 0
      fi
      echo
      debug_log "User input: '${user_input}'"

      case "${user_input}" in
        q | Q)
          debug_log "Action: quit"
          persist_video_state_if_needed "${video_state}" "${random_video}"
          echo "Goodbye!"
          exit 0
          ;;
        r | R)
          debug_log "Action: replay"
          echo -e "${DIM}Replaying...${NC}"
          video_path=$(convert_path_for_mpv "${random_video}")
          run_mpv "${video_path}"
          continue
          ;;
        i | I)
          debug_log "Action: show info"
          mediainfo "${random_video}"
          while true; do
            replay_input=""
            echo -e -n "[${DIM}r${NC}]eplay  [${DIM}b${NC}]ack: "
            if ! read_single_key replay_input; then
              echo ""
              persist_video_state_if_needed "${video_state}" "${random_video}"
              echo "Input closed. Goodbye!"
              exit 0
            fi
            echo
            debug_log "Info submenu input: '${replay_input}'"
            case "${replay_input}" in
              r | R)
                debug_log "Action: replay from info"
                video_path=$(convert_path_for_mpv "${random_video}")
                run_mpv "${video_path}"
                ;;
              b | B | q | Q | $'\n' | "")
                debug_log "Action: back to main menu"
                break
                ;;
              *)
                echo -e "${YELLOW}Invalid option '${replay_input}'.${NC}"
                ;;
            esac
          done
          continue
          ;;
        p | P)
          debug_log "Action: promote"
          if promote_video_to_main "${random_video}"; then
            video_state="keep"
            break
          fi
          continue
          ;;
        u | U)
          if [[ "${video_state}" == "watched" ]]; then
            debug_log "Action: undo watched"
            video_state="keep"
            echo -e "${DIM}Watched removal undone.${NC}"
          else
            echo -e "${YELLOW}Nothing to undo.${NC}"
          fi
          continue
          ;;
        d | D)
          debug_log "Action: delete prompt"
          confirmation=""
          echo ""
          echo -e "${RED}WARNING:${NC} This will permanently delete the file:"
          echo -e "${DIM}${random_video}${NC}"
          echo ""
          echo -e -n "Delete? [${RED}y${NC}/Enter=yes, ${DIM}n${NC}=no, ${CYAN}q${NC}=quit]: "
          if ! read_single_key confirmation; then
            echo ""
            persist_video_state_if_needed "${video_state}" "${random_video}"
            echo "Input closed. Goodbye!"
            exit 0
          fi
          echo
          debug_log "Delete confirmation: '${confirmation}'"
          case "${confirmation}" in
            y | Y | $'\n' | "")
              debug_log "Action: confirmed delete"
              if rm "${random_video}" 2>/dev/null; then
                echo -e "${GREEN}File deleted.${NC}"
                video_state="deleted"
              else
                echo -e "${RED}Failed to delete file.${NC} Check permissions."
              fi
              break
              ;;
            q | Q)
              debug_log "Action: quit from delete"
              persist_video_state_if_needed "${video_state}" "${random_video}"
              echo "Goodbye!"
              exit 0
              ;;
            n | N | *)
              debug_log "Action: cancel delete"
              echo -e "${DIM}Cancelled.${NC}"
              continue
              ;;
          esac
          ;;
        n | N | ' ' | "")
          debug_log "Action: next video"
          break
          ;;
        *)
          echo -e "${YELLOW}Invalid option '${user_input}'.${NC}"
          continue
          ;;
      esac
    done

    # Persist watched/delete state after action loop
    persist_video_state_if_needed "${video_state}" "${random_video}"
  else
    echo ""
    if [[ -n "${LAST_MPV_OUTPUT}" ]]; then
      echo -e "${RED}mpv failed while opening video.${NC}"
      printf '%s\n' "${LAST_MPV_OUTPUT}" | tail -n 20
    fi
    drain_tty_input_buffer
    echo -e -n "[${DIM}r${NC}]etry  [${CYAN}q${NC}]uit: "
    if ! read_single_key user_input; then
      echo ""
      echo "Input closed. Goodbye!"
      exit 0
    fi
    echo
    case "${user_input}" in
      q | Q)
        echo "Goodbye!"
        exit 0
        ;;
      r | R)
        continue
        ;;
      *)
        echo -e "${YELLOW}Invalid option '${user_input}'.${NC}"
        ;;
    esac
  fi
done
