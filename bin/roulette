#!/usr/bin/env bash
# roulette - Play random video files from one or more directories

set -e

VERSION="1.3.1" # x-release-please-version

# === ARGUMENT VARIABLES ===
ARG_DEBUG=""
ARG_RESET=""
ARG_CLEAN=""
ARG_FULLSCREEN=""
ARG_IGNORE_MPV_ENV=""
ARG_SCAN=""
ARG_SHUFFLE=""
ARG_FILTERS=()
ARG_DIRECTORIES=()

# === HELP AND VERSION ===
show_help() {
  cat <<'EOF'
roulette - Play random video files from one or more directories

Usage:
  roulette [DIRECTORY ...] [options]
  roulette --help | -h
  roulette --version | -v

Options:
  --help, -h
    Show this help

  --version, -v
    Show version number

  --debug, -d
    Enable debug mode

  --reset
    Empty playlist and rescan source directories

  --clean
    Validate playlist and remove stale entries (non-existent files)

  --fullscreen, -f
    Start video playback in fullscreen mode (macOS)

  --bypass
    Ignore MPV_GEOMETRY, MPV_VOLUME, and MPV_FULLSCREEN environment variables

  --scan, -s
    Scan source directories and sync playlist with filesystem

  --shuffle
    Shuffle across all source directories instead of honoring directory priority

  --filter QUERY
    Only queue videos whose file path or containing directory includes QUERY.
    May be used multiple times; explicit DIRECTORY arguments still override
    ROULETTE_PATH.

Arguments:
  DIRECTORY
    One or more paths to search for video files

Environment Variables:
  ROULETTE_DEBUG
    Enable debug mode

  ROULETTE_PATH
    Base path(s) to media directories. Use ':' to separate multiple paths
    (e.g., /Volumes/media/archive/video:/Volumes/media/archive/home-video)

  ROULETTE_DOWNLOADS_PATH
    Source root for [p]romote action

  ROULETTE_MAIN_PATH
    Destination root for [p]romote action

  MPV_GEOMETRY
    Set default window positioning (e.g., '50%x50%+0+0' for top-left corner)

  MPV_VOLUME
    Set default volume (0-100)

  MPV_FULLSCREEN
    Start playback in fullscreen mode (set to 1 to enable)
EOF
}

show_version() {
  echo "$VERSION"
}

# === ARGUMENT PARSING ===
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        show_help
        exit 0
        ;;
      -v | --version)
        show_version
        exit 0
        ;;
      -d | --debug)
        ARG_DEBUG=1
        shift
        ;;
      --reset)
        ARG_RESET=1
        shift
        ;;
      --clean)
        ARG_CLEAN=1
        shift
        ;;
      -f | --fullscreen)
        ARG_FULLSCREEN=1
        shift
        ;;
      --bypass)
        ARG_IGNORE_MPV_ENV=1
        shift
        ;;
      -s | --scan)
        ARG_SCAN=1
        shift
        ;;
      --shuffle)
        ARG_SHUFFLE=1
        shift
        ;;
      --filter)
        if [[ $# -lt 2 ]] || [[ -z "$2" ]]; then
          printf "missing value for option: %s\n" "$1" >&2
          exit 1
        fi
        ARG_FILTERS+=("$2")
        shift 2
        ;;
      -*)
        printf "invalid option: %s\n" "$1" >&2
        exit 1
        ;;
      *)
        ARG_DIRECTORIES+=("$1")
        shift
        ;;
    esac
  done
}

# === INITIALIZATION ===

# Colors
# shellcheck disable=SC2034
GREEN='\033[1;32m'
# shellcheck disable=SC2034
YELLOW='\033[1;33m'
# shellcheck disable=SC2034
RED='\033[1;31m'
# shellcheck disable=SC2034
CYAN='\033[1;36m'
# shellcheck disable=SC2034
DIM='\033[2m'
# shellcheck disable=SC2034
NC='\033[0m'
# shellcheck disable=SC2034
ICON="${GREEN}(::X::)${NC}"

# Debug logging function - prints verbose info when debug mode is enabled
debug_log() {
  if [[ -n "${ROULETTE_DEBUG}" || -n "${ARG_DEBUG:-}" ]]; then
    echo -e "${DIM}[DEBUG]${NC} $*" >&2
  fi
}

VIDEO_EXTENSIONS=(
  mp4 avi mkv mov wmv flv webm m4v mpg mpeg
)

MPV_PATH="/usr/local/bin/mpv"
MPV_PATH_ARM="/opt/homebrew/bin/mpv"
IS_WSL=false
IS_MACOS=false
DIRECTORY_PATH=""
DIRECTORY_PATHS=()
SCANNABLE_DIRECTORY_PATHS=()
UNSCANNABLE_DIRECTORY_PATHS=()
PLAYLIST_STORAGE_MODE="relative"
PLAYLIST_BASE_DIR=""
PLAYLIST_FILE=""
PROMOTE_DOWNLOADS_PATH=""
PROMOTE_MAIN_PATH=""
ABSOLUTE_STORAGE_PREFIX="ABS:"

