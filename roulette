#!/usr/bin/env bash
# roulette - Play random video files from one or more directories

set -e

VERSION="1.3.0" # x-release-please-version

# === ARGUMENT VARIABLES ===
ARG_DEBUG=""
ARG_RESET=""
ARG_CLEAN=""
ARG_FULLSCREEN=""
ARG_IGNORE_MPV_ENV=""
ARG_SHUFFLE=""
ARG_DIRECTORIES=()

# === HELP AND VERSION ===
show_help() {
  cat <<'EOF'
roulette - Play random video files from one or more directories

Usage:
  roulette [DIRECTORY ...] [options]
  roulette --help | -h
  roulette --version | -v

Options:
  --help, -h
    Show this help

  --version, -v
    Show version number

  --debug, -d
    Enable debug mode

  --reset
    Empty playlist and rescan source directories

  --clean
    Validate playlist and remove stale entries (non-existent files)

  --fullscreen, -f
    Start video playback in fullscreen mode (macOS)

  --bypass
    Ignore MPV_GEOMETRY, MPV_VOLUME, and MPV_FULLSCREEN environment variables

  --shuffle
    Shuffle across all source directories instead of honoring directory priority

Arguments:
  DIRECTORY
    One or more paths to search for video files

Environment Variables:
  ROULETTE_DEBUG
    Enable debug mode

  ROULETTE_PATH
    Base path(s) to media directories. Use ':' to separate multiple paths
    (e.g., /Volumes/media/archive/video:/Volumes/media/archive/home-video)

  MPV_GEOMETRY
    Set default window positioning (e.g., '50%x50%+0+0' for top-left corner)

  MPV_VOLUME
    Set default volume (0-100)

  MPV_FULLSCREEN
    Start playback in fullscreen mode (set to 1 to enable)
EOF
}

show_version() {
  echo "$VERSION"
}

# === ARGUMENT PARSING ===
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        show_help
        exit 0
        ;;
      -v | --version)
        show_version
        exit 0
        ;;
      -d | --debug)
        ARG_DEBUG=1
        shift
        ;;
      --reset)
        ARG_RESET=1
        shift
        ;;
      --clean)
        ARG_CLEAN=1
        shift
        ;;
      -f | --fullscreen)
        ARG_FULLSCREEN=1
        shift
        ;;
      --bypass)
        ARG_IGNORE_MPV_ENV=1
        shift
        ;;
      --shuffle)
        ARG_SHUFFLE=1
        shift
        ;;
      -*)
        printf "invalid option: %s\n" "$1" >&2
        exit 1
        ;;
      *)
        ARG_DIRECTORIES+=("$1")
        shift
        ;;
    esac
  done
}

