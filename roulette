#!/usr/bin/env bash
# roulette - Play random video files from a directory

set -e

VERSION="1.1.0"

# === ARGUMENT VARIABLES ===
ARG_DEBUG=""
ARG_RESET=""
ARG_CLEAN=""
ARG_FULLSCREEN=""
ARG_DIRECTORY=""

# === HELP AND VERSION ===
show_help() {
  cat <<'EOF'
roulette - Play random video files from a directory

Usage:
  roulette [DIRECTORY] [options]
  roulette --help | -h
  roulette --version | -v

Options:
  --help, -h
    Show this help

  --version, -v
    Show version number

  --debug, -d
    Enable debug mode

  --reset
    Empty playlist and rescan directory

  --clean
    Validate playlist and remove stale entries (non-existent files)

  --fullscreen, -f
    Start video playback in fullscreen mode (macOS)

Arguments:
  DIRECTORY
    Path to search for video files

Environment Variables:
  ROULETTE_DEBUG
    Enable debug mode

  ROULETTE_PATH
    Base path to media directory (e.g., /Volumes/media/archive/video or
    /mnt/media/archive/video)

  MPV_GEOMETRY
    Set default window positioning (e.g., '50%x50%+0+0' for top-left corner)

  MPV_VOLUME
    Set default volume (0-100)

  MPV_FULLSCREEN
    Start playback in fullscreen mode (set to 1 to enable)
EOF
}

show_version() {
  echo "$VERSION"
}

# === ARGUMENT PARSING ===
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        show_help
        exit 0
        ;;
      -v | --version)
        show_version
        exit 0
        ;;
      -d | --debug)
        ARG_DEBUG=1
        shift
        ;;
      --reset)
        ARG_RESET=1
        shift
        ;;
      --clean)
        ARG_CLEAN=1
        shift
        ;;
      -f | --fullscreen)
        ARG_FULLSCREEN=1
        shift
        ;;
      -*)
        printf "invalid option: %s\n" "$1" >&2
        exit 1
        ;;
      *)
        if [[ -z "$ARG_DIRECTORY" ]]; then
          ARG_DIRECTORY="$1"
          shift
        else
          printf "invalid argument: %s\n" "$1" >&2
          exit 1
        fi
        ;;
    esac
  done
}

